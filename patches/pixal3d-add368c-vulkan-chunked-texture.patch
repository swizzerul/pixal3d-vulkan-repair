+// Fixed public diagnostic ABI. It observes stage provenance; it never supplies values.
+#pragma once
+#include <cstdint>
+#include <initializer_list>
+#if defined(_WIN32)
+#define TRELLIS_COND_EXPORT __declspec(dllexport)
+#define TRELLIS_COND_NOINLINE __declspec(noinline)
+#else
+#define TRELLIS_COND_EXPORT __attribute__((visibility("default")))
+#define TRELLIS_COND_NOINLINE __attribute__((noinline))
+#endif
+extern "C" TRELLIS_COND_EXPORT TRELLIS_COND_NOINLINE
+void trellis_cond_event(int kind, const void* a, const void* b, const int64_t values[8]);
+namespace trellis {
+// Values: BEGIN S,R,T,V,N,chunk,rows,blocks; GRAPH stage,view,start,count.
+// Persistent slots: pooled,Q,K,V,global,LR,HR. Event identifiers are versioned here.
+enum CondEvent { COND_COORDS=0, COND_BEGIN=1, COND_PERSISTENT=2,
+    COND_GRAPH_BEGIN=3, COND_GRAPH_DONE=4, COND_END=5, COND_CHUNK_SKIP=6,
+    COND_SELECTION=7, COND_TAPS=8, COND_VIEW_DONE=9 };
+inline void cond_trace(int kind,const void* a,const void* b,std::initializer_list<int64_t> fields) {
+    int64_t values[8]{};int i=0;for(int64_t value:fields){if(i<8)values[i++]=value;}
+    trellis_cond_event(kind,a,b,values);
+}
+}
