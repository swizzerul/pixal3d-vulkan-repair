--- /dev/null
+++ b/include/geometry_checkpoint.h
@@ -0,0 +1,18 @@
+// Optional raw geometry preservation; no transforms, cleanup, or mutation.
+#pragma once
+#include "mesh_glb.h"
+#include <cmath>
+#include <cstdint>
+#include <filesystem>
+#include <stdexcept>
+#include <vector>
+namespace trellis {
+inline void write_geometry_checkpoint(const char* path,const std::vector<float>& verts,const std::vector<int32_t>& faces) {
+    if(!path || !*path || std::filesystem::exists(path) || verts.empty() || faces.empty() || verts.size()%3 || faces.size()%3)
+        throw std::runtime_error("geometry checkpoint: invalid/fresh output required");
+    for(float x:verts)if(!std::isfinite(x))throw std::runtime_error("geometry checkpoint: nonfinite position");
+    for(int32_t x:faces)if(x<0 || size_t(x)>=verts.size()/3)throw std::runtime_error("geometry checkpoint: invalid face");
+    if(!write_ply(path,verts.data(),int64_t(verts.size()/3),faces.data(),int64_t(faces.size()/3)))
+        throw std::runtime_error("geometry checkpoint: write failed");
+}
+}
